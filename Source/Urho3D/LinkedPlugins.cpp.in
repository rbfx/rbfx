#include <Urho3D/Plugins/Plugin.h>

extern "C"
{
@DECLARE_FUNCTIONS@
}

namespace Urho3D
{
namespace LinkedPlugins
{

const StringVector& GetLinkedPlugins()
{
    static const StringVector result = ea::string("@PLUGIN_LIST@").split(';');
    return result;
}

void RegisterStaticPlugins()
{
@REGISTER_PLUGINS@
}

}
}
